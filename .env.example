# ========== DATABASE CONFIG ==========
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tecnovariedades-db
DB_USER=postgres
DB_PASS=your_password

# ========== SERVER CONFIG ==========
PORT=3002
NODE_ENV=production
API_VERSION=v1

# ========== HERMES AGENT ==========
HERMES_URL=http://localhost:5000

# ========== AI PROVIDERS CONFIGURATION ==========
# GitHub Copilot (Primary)
GITHUB_COPILOT_TOKEN=your_github_copilot_token
GITHUB_TOKEN=your_github_token
GITHUB_MODEL=gpt-4o
GITHUB_MODEL_CLAUDE=claude-sonnet-4-20250514

# AI Fallback Chain
AI_FALLBACK_ENABLED=true
AI_FALLBACK_ORDER=opencode,github_copilot_internal,nvidia,github,g4f

# Bridge Local (Fallback 1)
BRIDGE_LOCAL_URL=http://localhost:8000/api/v1
BRIDGE_LOCAL_API_KEY=your_bridge_local_api_key
BRIDGE_LOCAL_MODEL=deepseek-v4-flash

# NVIDIA (Fallback 2)
NVIDIA_API_KEY=your_nvidia_api_key
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_MODEL_FAST=meta/llama-3.1-8b-instruct
NVIDIA_TIMEOUT=8000

# Ollama Local (Opcional)
# OLLAMA_LOCAL_URL=http://localhost:11434
# OLLAMA_LOCAL_MODEL=qwen3-coder:480b-cloud
# OLLAMA_TIMEOUT=60

# GitHub G4F (Fallback 4)
G4F_ENABLED=true
G4F_PROVIDER=auto
G4F_MODEL=gpt-4-turbo
G4F_TIMEOUT=10000

# ========== PAYMENTS (Colombia) ==========
TRANSFER_NUMBER=your_transfer_number
TRANSFER_NAME=Your Name
MERCADO_PAGO_PUBLIC_KEY=your_mercado_pago_public_key
MERCADO_PAGO_ACCESS_TOKEN=your_mercado_pago_access_token
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=live

# ========== NOTIFICATIONS (Email with SMTP) ==========
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=your_email@gmail.com
EMAIL_TO=recipient@example.com

# ========== PERFORMANCE & ANTI-BAN ==========
TYPING_DELAY_MIN=800
TYPING_DELAY_MAX=2000
READ_RECEIPT_DELAY=500
HUMAN_PAUSE_MIN=1000
HUMAN_PAUSE_MAX=3000
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60000

# ========== GIT AUTO-UPDATE ==========
GIT_BRANCH=main
GIT_REMOTE=origin

# ========== OPENCODE AI PROVIDER ==========
OPENCODE_API_URL=https://your-opencode-instance.com/v1
OPENCODE_MODEL=opencode/deepseek-v4-flash-free
OPENCODE_API_KEY=your_opencode_api_key

# ========== DATABASE POOL OPTIMIZATION ==========
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000
DB_STATEMENT_TIMEOUT=10000
DB_QUERY_TIMEOUT=10000
