# ========== CONFIGURACIÓN DE PRODUCCIÓN ==========
NODE_ENV=production
PORT=3002
HOST=0.0.0.0
LOG_LEVEL=info

# ========== BASE DE DATOS (PostgreSQL) ==========
# Formato: postgres://usuario:password@host:puerto/database
DATABASE_URL=postgres://usuario:password@host:5432/database?sslmode=disable

# ========== HERMES AGENT (GitHub Models) ==========
HERMES_URL=http://localhost:5000
GITHUB_TOKEN=tu-github-token-aqui
GITHUB_MODEL=gpt-4o-mini
GITHUB_MODEL_CLAUDE=claude-sonnet-4-20250514

# ========== AI INTEGRATIONS (NVIDIA) ==========
NVIDIA_API_KEY=tu-nvidia-api-key-aqui
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
AI_FALLBACK_ORDER=nvidia,github,ollama_local

# ========== FALLBACK AI (Ollama Local) ==========
AI_FALLBACK_ENABLED=true
OLLAMA_LOCAL_URL=http://localhost:11434
OLLAMA_LOCAL_MODEL=hermes3:8b

# ========== PAGOS COLOMBIA ==========
# Transferencia bancaria
TRANSFER_NUMBER=tu-numero-aqui
TRANSFER_NAME=Tu Nombre

# Mercado Pago
MERCADO_PAGO_PUBLIC_KEY=tu-public-key-aqui
MERCADO_PAGO_ACCESS_TOKEN=tu-access-token-aqui

# PayPal
PAYPAL_CLIENT_ID=tu-client-id-aqui
PAYPAL_CLIENT_SECRET=tu-client-secret-aqui
PAYPAL_MODE=sandbox

# ========== NOTIFICACIONES (Email SMTP) ==========
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-email@gmail.com
SMTP_PASS=tu-app-password-aqui
EMAIL_FROM=tu-email@gmail.com
EMAIL_TO=email-destino@gmail.com

# ========== ANTI-BAN & PERFORMANCE ==========
TYPING_DELAY_MIN=800
TYPING_DELAY_MAX=2000
READ_RECEIPT_DELAY=500
HUMAN_PAUSE_MIN=1000
HUMAN_PAUSE_MAX=3000

# ========== GIT ==========
GIT_BRANCH=main
