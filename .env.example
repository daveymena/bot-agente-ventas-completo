# ========== SERVER ==========
NODE_ENV=production
PORT=3002
HOST=0.0.0.0

# ========== BASE DE DATOS ==========
# USE_SQLITE=true para SQLite local, USE_SQLITE=false para PostgreSQL
USE_SQLITE=false
DATABASE_URL=postgres://user:password@host:5432/dbname

# ========== INTELIGENCIA ARTIFICIAL PRINCIPAL (OPENCODE) ==========
OPENCODE_API_URL=https://tu-servicio.opencode.ai/v1
OPENCODE_MODEL=opencode/deepseek-v4-flash-free
OPENCODE_API_KEY=sk_tu_api_key

# ========== SISTEMA DE FALLBACKS DE IA ==========
AI_FALLBACK_ENABLED=true
AI_FALLBACK_ORDER=opencode,github,nvidia,g4f

# Credenciales de GitHub Models / Copilot
GITHUB_TOKEN=ghp_tu_token
GITHUB_MODEL=gpt-4o-mini
GITHUB_MODEL_CLAUDE=claude-sonnet-4-20250514

# Credenciales de Nvidia NIM
NVIDIA_API_KEY=nvapi-tu_key
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# ========== G4F (gpt4free - último respaldo) ==========
G4F_ENABLED=true
G4F_PROVIDER=auto
G4F_MODEL=gpt-4-turbo
G4F_TIMEOUT=8

# ========== PAGOS COLOMBIA ==========
TRANSFER_NUMBER=3000000000
TRANSFER_NAME="Tu Nombre"

MERCADO_PAGO_PUBLIC_KEY=APP_USR-tu_public_key
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-tu_access_token

PAYPAL_CLIENT_ID=tu_paypal_client_id
PAYPAL_CLIENT_SECRET=tu_paypal_secret
PAYPAL_MODE=live

# ========== ENVÍO DE EMAILS ==========
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASS="tu contraseña de aplicacion"
EMAIL_FROM=tu_correo@gmail.com
EMAIL_TO=destinatario@gmail.com

# ========== COMPORTAMIENTO ANTI-BAN DE WHATSAPP ==========
TYPING_DELAY_MIN=800
TYPING_DELAY_MAX=2000
READ_RECEIPT_DELAY=500
HUMAN_PAUSE_MIN=1000
HUMAN_PAUSE_MAX=3000

# ========== LOGGING ==========
LOG_LEVEL=info
