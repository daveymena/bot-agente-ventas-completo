# ========== DATABASE ==========
# SQLite (local dev) — set to true for zero-config local development
USE_SQLITE=true
SQLITE_PATH=./data/tecnovariedades.db

# PostgreSQL (production) — only needed when USE_SQLITE=false
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=disable

# ========== SERVER ==========
PORT=3002
NODE_ENV=development
# combined keeps the current single-process deployment. Split production roles
# only after creating a private gateway service and one or more worker services.
VENTASPRO_PROCESS_ROLE=combined
# Set the same random secret (32+ characters) on gateway and worker services.
# WHATSAPP_GATEWAY_TOKEN=
# Worker only: HTTPS origin of the private gateway, with no path.
# WHATSAPP_GATEWAY_URL=https://whatsapp-gateway.internal
# DB_POOL_MAX=20
# Máximo total de respuestas IA activas en este despliegue/cluster.
# AGENT_CONCURRENCIA=4
# AGENT_GLOBAL_CONCURRENCIA=4
# AGENT_MAX_EN_PARALELO_TENANT=4

# ========== SECURITY ==========
# Signs the tenant_id session cookie. REQUIRED in production (server refuses
# to boot without it) — without a signed cookie, anyone could forge
# `tenant_id=<number>` and authenticate as any tenant with no password.
# Generate your own: python -c "import secrets; print(secrets.token_hex(32))"
COOKIE_SECRET=

# Encrypts third-party tokens/credentials each tenant saves from the
# dashboard (Facebook access token, app secret, GitHub PAT, etc.) before they
# hit the database. Without it, credentials fall back to a random in-memory
# key that changes on every restart — anything encrypted before a restart
# becomes unreadable. Set a fixed value in production.
# Generate your own: python -c "import secrets; print(secrets.token_hex(32))"
CREDENTIALS_ENCRYPTION_KEY=

# ========== GOOGLE LOGIN (OAuth 2.0 / OpenID Connect) ==========
# "Continuar con Google". Autorización por code (server-side): el client
# secret SOLO vive acá, nunca en el frontend. En Google Cloud Console →
# API Credentials → OAuth 2.0 Client ID (tipo "Web application").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Redirect URI registrada en Google (authorized redirect URIs). Debe ser EXACTA:
#   Dev:  http://localhost:3002/api/auth/google/callback
#   Prod: https://ventasproia.com/api/auth/google/callback
GOOGLE_REDIRECT_URI=
# OPCIONAL (solo dev): a dónde volver después de autenticar. En producción el
# frontend comparte origen con la API y esto se deja vacío.
#   Dev: http://localhost:5173
# GOOGLE_LOGIN_REDIRECT=

# ========== AI PROVIDERS ==========
# At least ONE AI provider key is required for the bot to work.

# OpenCode (free, recommended for dev)
OPENCODE_API_URL=https://api.freemodel.dev/v1
OPENCODE_MODEL=deepseek-v4-flash-free
OPENCODE_API_KEY=your_opencode_api_key

# Groq (fast, free tier available)
# GROQ_API_KEY=gsk_your_groq_key
# GROQ_MODEL=llama-3.1-8b-instant

# DeepSeek (principal para landings; si falta, la cadena sigue con los de abajo)
# DEEPSEEK_API_KEY=sk-your-deepseek-key
# DEEPSEEK_MODEL=deepseek-chat

# OpenRouter (fallback gratuito)
# OPENROUTER_API_KEY=sk-or-your-key
# OPENROUTER_MODEL=qwen/qwen-2.5-7b-instruct:free

# Cerebras (fallback gratuito)
# CEREBRAS_API_KEY=csk-your-key
# CEREBRAS_MODEL=llama-3.1-8b-instruct

# Ollama local (EasyPanel) y cloud
# OLLAMA_LOCAL_URL=http://localhost:11434
# OLLAMA_CLOUD_API_KEY=your-ollama-cloud-key

# GitHub Models (requires GitHub token)
# GITHUB_TOKEN=ghp_your_github_token
# GITHUB_MODEL=gpt-4o-mini

# AI Fallback Chain
AI_FALLBACK_ENABLED=true
AI_FALLBACK_ORDER=opencode,groq,github

# ========== WHATSAPP ==========
WA_BROWSER_NAME=Chrome
WA_BROWSER_PLATFORM=Windows
WA_BROWSER_VERSION=130.0.0.0
WA_RANDOMIZE_FINGERPRINT=true
WA_BUSINESS_HOURS_START=08:00
WA_BUSINESS_HOURS_END=23:59
WA_TIMEZONE=America/Bogota
WA_MAX_MSGS_PER_HOUR=40
WA_MAX_MSGS_PER_DAY=300
# Voz del agente (Edge TTS es-CO, gratis). Ya NO se manda junto al texto: o va
# texto o va audio, nunca los dos. Las fichas (producto, precio, pago, entrega)
# van siempre con texto + imagen; un razonamiento puede ir hablado.
# WHATSAPP_AUDIO_ENABLED=false
# Voz: es-CO-SalomeNeural (mujer) | es-CO-GonzaloNeural (hombre)
# WHATSAPP_AUDIO_VOICE=es-CO-SalomeNeural
# Probabilidad de hablar un razonamiento (0 = nunca voz, 1 = siempre voz). Default 0.5.
# WHATSAPP_AUDIO_PROB=0.5
# Largo mínimo del texto para que valga la pena hablarlo. Default 120.
# WHATSAPP_AUDIO_MIN_CHARS=120
TYPING_WPM=400
ADMIN_PHONE=your_phone_number

# ========== WHATSAPP CLOUD API (segunda opción, opcional) ==========
# Dejar Baileys por defecto. Cuando quieras migrar un número a la Cloud API
# oficial de Meta, activá: WHATSAPP_CLOUD_ENABLED=true (o WHATSAPP_TRANSPORT=cloud).
# Un número NO puede estar a la vez en Baileys y en Cloud API.
# WHATSAPP_TRANSPORT=baileys
# WHATSAPP_CLOUD_ENABLED=false
# WHATSAPP_CLOUD_TOKEN=EAAG...          # System User token permanente con whatsapp_business_messaging
# WHATSAPP_CLOUD_PHONE_NUMBER_ID=1234   # id del número en el WABA
# WHATSAPP_CLOUD_WABA_ID=               # opcional
# WHATSAPP_CLOUD_TENANT_ID=1            # a qué negocio responde este número
# WHATSAPP_CLOUD_VERIFY_TOKEN=          # token para verificar el webhook
# WHATSAPP_CLOUD_API_VERSION=v23.0      # opcional (usa META_API_VERSION por defecto)

# ========== COBRO POR CONVERSACIÓN (excedente sobre el plan) ==========
# El plan incluye N conversaciones (monthlyConversations en saasValidation.ts).
# El excedente se cobra al negocio por encima del costo real de Meta.
# WHATSAPP_CONVERSATION_COST_USD=0.01   # lo que te cobra Meta (servicio)
# WHATSAPP_CONVERSATION_PRICE_USD=0.04  # lo que le cobrás al negocio por conversación excedente

# Cuenta admin creada automáticamente si la BD está vacía (primer arranque).
# Sin estas dos, app.ts genera una contraseña aleatoria y la imprime en el log.
ADMIN_EMAIL=your_admin_email
ADMIN_PASSWORD=choose_a_strong_password

# ========== PAYMENTS ==========
TRANSFER_NUMBER=your_number
TRANSFER_NAME=Your Name
# MERCADO_PAGO_PUBLIC_KEY=your_key
# MERCADO_PAGO_ACCESS_TOKEN=your_token
# PAYPAL_CLIENT_ID=your_id
# PAYPAL_CLIENT_SECRET=your_secret
# PAYPAL_MODE=sandbox

# ========== EMAIL (SMTP) ==========
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# EMAIL_FROM=your_email@gmail.com
# EMAIL_TO=recipient@example.com

# ========== FACEBOOK ==========
# FB_APP_ID=your_app_id
# FB_APP_SECRET=your_app_secret
# FB_PAGE_ID=your_page_id
# FB_ACCESS_TOKEN=your_access_token

# ========== PERFORMANCE ==========
TYPING_DELAY_MIN=800
TYPING_DELAY_MAX=2500
READ_RECEIPT_DELAY=500
HUMAN_PAUSE_MIN=1500
HUMAN_PAUSE_MAX=5000

# ========== DROPI (dropshipping) ==========
# Token de SESIÓN del panel de Dropi (F12 → Application → localStorage → DROPI_token).
# NO uses un token de "Mis Integraciones": esos filtran por IP (whitelist que
# administra Dropi). El de sesión no filtra, pero caduca y hay que renovarlo.
DROPI_TOKEN=
DROPI_API_URL=https://api.dropi.co

# ========== MOTOR DEL VENDEDOR DE WHATSAPP ==========
# v1 = el motor de siempre (defecto: nadie cambia si no se toca nada).
# v2 = el nuevo: razona con herramientas, saca precio/medios de pago/entrega de
#      la base y recuerda lo que ya le dijo a cada cliente.
MOTOR_VENDEDOR=v1
# Negocios que van al v2 aunque el valor global sea v1 (ids separados por coma).
# MOTOR_VENDEDOR_TENANTS=3,7
# O un porcentaje del tráfico, estable por negocio (el mismo siempre cae del
# mismo lado, así que no "parpadea" entre motores).
# MOTOR_VENDEDOR_PORCENTAJE=10
