# ========== DATABASE ==========
# SQLite (local dev) — set to true for zero-config local development
USE_SQLITE=true
SQLITE_PATH=./data/tecnovariedades.db

# PostgreSQL (production) — only needed when USE_SQLITE=false
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=disable

# ========== SERVER ==========
PORT=3002
NODE_ENV=development

# ========== SECURITY ==========
# Signs the tenant_id session cookie. REQUIRED in production (server refuses
# to boot without it) — without a signed cookie, anyone could forge
# `tenant_id=<number>` and authenticate as any tenant with no password.
# Generate your own: python -c "import secrets; print(secrets.token_hex(32))"
COOKIE_SECRET=

# Encrypts third-party tokens/credentials each tenant saves from the
# dashboard (Facebook access token, app secret, GitHub PAT, etc.) before they
# hit the database. Without it, credentials fall back to a random in-memory
# key that changes on every restart — anything encrypted before a restart
# becomes unreadable. Set a fixed value in production.
# Generate your own: python -c "import secrets; print(secrets.token_hex(32))"
CREDENTIALS_ENCRYPTION_KEY=

# ========== AI PROVIDERS ==========
# At least ONE AI provider key is required for the bot to work.

# OpenCode (free, recommended for dev)
OPENCODE_API_URL=https://api.freemodel.dev/v1
OPENCODE_MODEL=deepseek-v4-flash-free
OPENCODE_API_KEY=your_opencode_api_key

# Groq (fast, free tier available)
# GROQ_API_KEY=gsk_your_groq_key
# GROQ_MODEL=llama-3.1-8b-instant

# GitHub Models (requires GitHub token)
# GITHUB_TOKEN=ghp_your_github_token
# GITHUB_MODEL=gpt-4o-mini

# AI Fallback Chain
AI_FALLBACK_ENABLED=true
AI_FALLBACK_ORDER=opencode,groq,github

# ========== WHATSAPP ==========
WA_BROWSER_NAME=Chrome
WA_BROWSER_PLATFORM=Windows
WA_BROWSER_VERSION=130.0.0.0
WA_RANDOMIZE_FINGERPRINT=true
WA_BUSINESS_HOURS_START=08:00
WA_BUSINESS_HOURS_END=23:59
WA_TIMEZONE=America/Bogota
WA_MAX_MSGS_PER_HOUR=40
WA_MAX_MSGS_PER_DAY=300
TYPING_WPM=400
ADMIN_PHONE=your_phone_number

# Cuenta admin creada automáticamente si la BD está vacía (primer arranque).
# Sin estas dos, app.ts genera una contraseña aleatoria y la imprime en el log.
ADMIN_EMAIL=your_admin_email
ADMIN_PASSWORD=choose_a_strong_password

# ========== PAYMENTS ==========
TRANSFER_NUMBER=your_number
TRANSFER_NAME=Your Name
# MERCADO_PAGO_PUBLIC_KEY=your_key
# MERCADO_PAGO_ACCESS_TOKEN=your_token
# Secreto del webhook de MercadoPago. Sin esto, la firma de los webhooks NO se
# verifica (se avisa en logs). Ponlo para bloquear webhooks falsos que activen
# suscripciones sin pago. Se obtiene en el panel de MercadoPago → Webhooks.
# MERCADO_PAGO_WEBHOOK_SECRET=your_webhook_secret
# PAYPAL_CLIENT_ID=your_id
# PAYPAL_CLIENT_SECRET=your_secret
# PAYPAL_MODE=sandbox
# ID del webhook de PayPal. Sin esto, la firma NO se verifica y un POST falso
# puede activar una suscripción sin pago. Se obtiene en PayPal Developer →
# tu App → Webhooks. Requiere PAYPAL_CLIENT_ID/SECRET para poder validar.
# PAYPAL_WEBHOOK_ID=your_webhook_id

# ========== EMAIL (SMTP) ==========
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# EMAIL_FROM=your_email@gmail.com
# EMAIL_TO=recipient@example.com

# ========== FACEBOOK ==========
# FB_APP_ID=your_app_id
# FB_APP_SECRET=your_app_secret
# FB_PAGE_ID=your_page_id
# FB_ACCESS_TOKEN=your_access_token

# ========== PERFORMANCE ==========
TYPING_DELAY_MIN=800
TYPING_DELAY_MAX=2500
READ_RECEIPT_DELAY=500
HUMAN_PAUSE_MIN=1500
HUMAN_PAUSE_MAX=5000

# ========== DROPI (dropshipping) ==========
# Token de SESIÓN del panel de Dropi (F12 → Application → localStorage → DROPI_token).
# NO uses un token de "Mis Integraciones": esos filtran por IP (whitelist que
# administra Dropi). El de sesión no filtra, pero caduca y hay que renovarlo.
DROPI_TOKEN=
DROPI_API_URL=https://api.dropi.co
