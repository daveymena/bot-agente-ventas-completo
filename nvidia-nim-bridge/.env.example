# NVIDIA NIM API Key (get one free at https://build.nvidia.com/settings/api-keys)
NVIDIA_API_KEY=nvapi-your-key-here

# Bridge server configuration
PORT=3000
HOST=0.0.0.0

# Default model to use
MODEL=moonshotai/kimi-k2.6

# Rate limiting (requests per minute to NVIDIA - free tier is ~40 RPM)
RPM_LIMIT=30

# Probe enabled models on startup (takes ~30-60s)
PROBE_ON_START=false
