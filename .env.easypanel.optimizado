# ========== DATABASE CONFIG (EasyPanel Production - OPTIMIZADO) ==========
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=disable
DB_HOST=your-db-host
DB_PORT=5432
DB_NAME=your-db-name
DB_USER=your-db-user
DB_PASS=your-db-password

# ========== SERVER CONFIG ==========
PORT=3002
NODE_ENV=production
API_VERSION=v1

# ========== SECURITY ==========
# Firma la cookie de sesión (tenant_id). Configúralo en las variables de
# entorno de Easypanel (NO lo dejes aquí en el repo). Si falta, el servidor
# arranca igual pero las sesiones se reinician en cada reinicio del contenedor.
# Genera uno: python -c "import secrets; print(secrets.token_hex(32))"
COOKIE_SECRET=

# ========== HERMES AGENT ==========
HERMES_URL=http://localhost:5000

# ========== AI PROVIDERS CONFIGURATION (OPTIMIZADO PARA EASYPANEL) ==========
# GitHub Copilot (Primary)
GITHUB_COPILOT_TOKEN=your-github-copilot-jwt-token
GITHUB_TOKEN=your-github-token
GITHUB_MODEL=gpt-4o
GITHUB_MODEL_CLAUDE=claude-sonnet-4-20250514

# AI Fallback Chain (OPTIMIZADO - SIN OLLAMA, SOLO PROVEEDORES RÁPIDOS)
AI_FALLBACK_ENABLED=true
AI_FALLBACK_ORDER=opencode,github_copilot_internal,nvidia,github,g4f

# Bridge Local (Fallback 1)
BRIDGE_LOCAL_URL=http://localhost:8000/api/v1
BRIDGE_LOCAL_API_KEY=your-bridge-api-key
BRIDGE_LOCAL_MODEL=deepseek-v4-flash

# NVIDIA (Fallback 2)
NVIDIA_API_KEY=your-nvidia-api-key
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_MODEL_FAST=meta/llama-3.1-8b-instruct
NVIDIA_TIMEOUT=8000

# Ollama Local (DESHABILITADO - MUY LENTO EN EASYPANEL)
# OLLAMA_LOCAL_URL=https://tecnovariedades-ollama.er7iaf.easypanel.host
# OLLAMA_LOCAL_MODEL=qwen3-coder:480b-cloud
# OLLAMA_TIMEOUT=60

# GitHub G4F (Fallback 4 - Last resort)
G4F_ENABLED=true
G4F_PROVIDER=auto
G4F_MODEL=gpt-4-turbo
G4F_TIMEOUT=10000

# ========== PAYMENTS (Colombia) ==========
TRANSFER_NUMBER=your-transfer-number
TRANSFER_NAME=your-name
MERCADO_PAGO_PUBLIC_KEY=your-mercadopago-public-key
MERCADO_PAGO_ACCESS_TOKEN=your-mercadopago-access-token
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_MODE=live

# ========== NOTIFICATIONS (Email with SMTP) ==========
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-smtp-password
EMAIL_FROM=your-email@gmail.com
EMAIL_TO=your-notification-email@gmail.com

# ========== PERFORMANCE & ANTI-BAN ==========
TYPING_DELAY_MIN=800
TYPING_DELAY_MAX=2000
READ_RECEIPT_DELAY=500
HUMAN_PAUSE_MIN=1000
HUMAN_PAUSE_MAX=3000
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60000

# ========== GIT AUTO-UPDATE ==========
GIT_BRANCH=main
GIT_REMOTE=origin

# ========== OPENCODE AI PROVIDER (EasyPanel Hosted - OPTIMIZADO) ==========
OPENCODE_API_URL=https://your-opencode-api-url/v1
OPENCODE_MODEL=opencode/deepseek-v4-flash-free
OPENCODE_API_KEY=your-opencode-api-key

# ========== DATABASE POOL OPTIMIZATION (NUEVO) ==========
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000
DB_STATEMENT_TIMEOUT=10000
DB_QUERY_TIMEOUT=10000
