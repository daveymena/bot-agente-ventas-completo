auto-install-peers=false
strict-peer-dependencies=false

# Allow exotic (git-based) subdependencies — required for @whiskeysockets/baileys@7 (libsignal)
allow-build=libsignal,@adiwajshing/keyed-db,@whiskeysockets/baileys
enable-pre-post-scripts=true

# pnpm v11 specific: disable blockExoticSubdeps check
dangerously-allow-all-builds=true
