# =============================================================================
# Sofía AI Sales Bot — Variables para EasyPanel (TEMPLATE)
# =============================================================================
# ℹ️  REEMPLAZA los valores marcados con *** con tus claves reales.
# =============================================================================

# ─── Servidor ───────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3002
HOST=0.0.0.0
LOG_LEVEL=info

# ─── Base de datos (PostgreSQL) ─────────────────────────────────────────────
DATABASE_URL=postgres://postgres:***DB_PASSWORD***@postgres:5432/tecnovariedades-db?sslmode=disable

# ─── AI — OpenCode local (proxy interno) ────────────────────────────────────
OPENCODE_API_URL=http://opencode-proxy:5000/v1
OPENCODE_MODEL=opencode/deepseek-v4-flash-free
OPENCODE_API_KEY=***API_KEY_DEL_PROXY***

# ─── AI — NVIDIA Fallback ───────────────────────────────────────────────────
NVIDIA_API_KEY=***NVIDIA_API_KEY***
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
AI_FALLBACK_ORDER=opencode,nvidia,github,ollama_local

# ─── AI — GitHub Models Fallback ────────────────────────────────────────────
GITHUB_TOKEN=***GITHUB_TOKEN***
GITHUB_MODEL=gpt-4o-mini
GITHUB_MODEL_CLAUDE=claude-sonnet-4-20250514

# ─── AI — Ollama local Fallback ─────────────────────────────────────────────
AI_FALLBACK_ENABLED=true
OLLAMA_LOCAL_URL=http://ollama:11434
OLLAMA_LOCAL_MODEL=hermes3:8b

# ─── Pagos ──────────────────────────────────────────────────────────────────
TRANSFER_NUMBER=3136174267
TRANSFER_NAME=Deiner Mena
MERCADO_PAGO_PUBLIC_KEY=***MERCADO_PAGO_KEY***
MERCADO_PAGO_ACCESS_TOKEN=***MERCADO_PAGO_TOKEN***
PAYPAL_CLIENT_ID=***PAYPAL_CLIENT_ID***
PAYPAL_CLIENT_SECRET=***PAYPAL_SECRET***
PAYPAL_MODE=live

# ─── Notificaciones ─────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=***EMAIL***
SMTP_PASS=***APP_PASSWORD***
EMAIL_FROM=***EMAIL***
EMAIL_TO=***EMAIL***

# ─── Anti-ban & Performance ─────────────────────────────────────────────────
TYPING_DELAY_MIN=800
TYPING_DELAY_MAX=2000
READ_RECEIPT_DELAY=500
HUMAN_PAUSE_MIN=1000
HUMAN_PAUSE_MAX=3000

# ─── Git ────────────────────────────────────────────────────────────────────
GIT_BRANCH=main
