# ============================================================
# 🤖 TODOS LOS PROVEEDORES DE IA - free-llm-api-resources
# ============================================================
# Fuente: https://github.com/cheahjs/free-llm-api-resources.git
#
# Este archivo lista TODOS los proveedores gratuitos y con
# créditos de prueba. Copia las variables que necesites a tu
# .env principal.
#
# Sistema de rotación automática: si un proveedor falla,
# el sistema rota automáticamente al siguiente disponible.
# ============================================================

# ============================================================ #
# 🆓 PROVEEDORES 100% GRATIS                                     #
# ============================================================ #

# ── OpenRouter ── 20 req/min · 50 req/día (↑ 1000 con $10 top-up)
# Registro: https://openrouter.ai
OPENROUTER_API_KEY=sk-or-v1-...
# Modelos gratuitos disponibles (cambiar según necesidad):
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# OPENROUTER_MODEL=deepseek/deepseek-v4-flash:free
# OPENROUTER_MODEL=google/gemma-4-31b-it:free
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# OPENROUTER_MODEL=qwen/qwen3-coder:free
# OPENROUTER_MODEL=openai/gpt-oss-120b:free

# ── Google AI Studio ── 500 req/día · 250k tokens/min
# Registro: https://aistudio.google.com/apikey
GOOGLE_API_KEY=AIzaSy...
# OPENROUTER_MODEL no, es GOOGLE_MODEL para Google
GOOGLE_MODEL=gemini-2.5-flash
# GOOGLE_MODEL=gemini-2.5-flash-lite
# GOOGLE_MODEL=gemma-3-27b-it

# ── NVIDIA NIM ── 40 req/min · requiere verificación de teléfono
# Registro: https://build.nvidia.com/explore
NVIDIA_API_KEY=nvapi-...
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_MODEL_FAST=meta/llama-3.1-8b-instruct

# ── Mistral (La Plateforme) ── 1 req/seg · 500M tokens/mes
# Registro: https://console.mistral.ai/
MISTRAL_API_KEY=...
MISTRAL_MODEL=mistral-small-latest
# MISTRAL_MODEL=open-mixtral-8x7b

# ── Mistral Codestral ── 2,000 req/día · 30 req/min
# Registro: https://console.mistral.ai/ (misma cuenta)
# Mismas credenciales que Mistral
MISTRAL_API_KEY=...

# ── HuggingFace Inference ── $0.10/mes en créditos
# Registro: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_...
HUGGINGFACE_MODEL=meta-llama/Llama-3.3-70B-Instruct

# ── Vercel AI Gateway ── $5/mes
# Registro: https://vercel.com/dashboard (en la sección de AI Gateway)
VERCEL_AI_GATEWAY_TOKEN=...
VERCEL_AI_MODEL=openai/gpt-4o-mini

# ── OpenCode Zen ── Free tier · datos pueden usarse para mejora
# Registro: https://opencode.ai/zen
OPENCODE_ZEN_API_KEY=...
OPENCODE_ZEN_MODEL=deepseek-v4-flash-free

# ── Cerebras ── 1M tokens/día
# Registro: https://cloud.cerebras.ai/
CEREBRAS_API_KEY=...
CEREBRAS_MODEL=llama-3.1-8b-instruct

# ── Groq ── LPU ultra-rápido · 1,000–14,400 req/día
# Registro: https://console.groq.com/
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_MODEL=mistral-saba-24b

# ── GitHub Models ── según suscripción Copilot
# Usa el mismo token de GitHub
GITHUB_TOKEN=ghp_...
GITHUB_MODEL=meta-llama/llama-3.3-70b-instruct

# ── Cohere ── 1,000 req/mes
# Registro: https://dashboard.cohere.com/
COHERE_API_KEY=...
COHERE_MODEL=command-a-03-2025

# ── Cloudflare Workers AI ── 10,000 neuronas/día
# Registro: https://dash.cloudflare.com → Workers & Pages → AI
CLOUDFLARE_ACCOUNT_ID=...
CLOUDFLARE_API_TOKEN=...
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# ── DeepSeek ── open source · API propia
# Registro: https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-chat

# ── Perplexity ── $5 gratis al registro
# Registro: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=pplx-...
PERPLEXITY_MODEL=sonar-pro

# ── Together AI ── $5 gratis al registro
# Registro: https://api.together.xyz/
TOGETHER_API_KEY=...
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# ── OpenPipe ── free tier
# Registro: https://openpipe.ai/
OPENPIPE_API_KEY=...
OPENPIPE_MODEL=openai/gpt-4o-mini

# ── Anyscale ── $5 gratis
# Registro: https://console.anyscale.com/
ANYSCALE_API_KEY=...
ANYSCALE_MODEL=meta-llama/Llama-3.3-70B-Instruct


