UPSTAGE_API_KEY=...
UPSTAGE_MODEL=solar-pro2

# ── Novita ── $0.50 / 1 año
# Registro: https://novita.ai/ (referral enlace en GitHub)
NOVITA_API_KEY=...
NOVITA_MODEL=meta-llama/llama-3.1-70b-instruct

# ── Nebius ── $1 crédito
# Registro: https://tokenfactory.nebius.com/
NEBIUS_API_KEY=...
NEBIUS_MODEL=meta-llama/llama-3.3-70b-instruct

# ── Alibaba Cloud ── 1M tokens/modelo
# Registro: https://bailian.console.alibabacloud.com/
ALIBABA_API_KEY=...
ALIBABA_MODEL=qwen-plus

# ── Hyperbolic ── $1 crédito
# Registro: https://app.hyperbolic.ai/
HYPERBOLIC_API_KEY=...
HYPERBOLIC_MODEL=meta-llama/Llama-3.3-70B-Instruct

# ── SambaNova Cloud ── $5 / 3 meses
# Registro: https://cloud.sambanova.ai/
SAMBANOVA_API_KEY=...
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct

# ── NLP Cloud ── $15 crédito · requiere verificación de teléfono
# Registro: https://nlpcloud.com/
NLP_CLOUD_API_KEY=...
NLP_CLOUD_MODEL=meta-llama-3.1-70b-instruct

# ── Modal ── $5/mes (+$30 con método de pago)
# Registro: https://modal.com/
MODAL_TOKEN_ID=...
MODAL_TOKEN_SECRET=...
MODAL_BASE_URL=https://api.modal.com/v1
MODAL_MODEL=meta-llama/Llama-3.3-70B-Instruct

# ── Inference.net ── $1 (+$25 por encuesta)
# Registro: https://inference.net/
INFERENCE_NET_API_KEY=...
INFERENCE_NET_MODEL=llama-3.3-70b-instruct

# ── Scaleway Generative APIs ── 1M tokens gratis
# Registro: https://console.scaleway.com/generative-api
SCALEWAY_API_KEY=...
SCALEWAY_MODEL=llama-3.3-70b-instruct

# MODELS — Claude Haiku 4.5 via GitHub (free, faster)
# ============================================================ #
# GITHUB_MODEL_CLAUDE=claude-3.5-haiku
# ============================================================ #


# ============================================================ #
# 🛠️ PROVEEDORES EXISTENTES / LOCALES                            #
# ============================================================ #

# ── GitHub Copilot / GitHub Models
GITHUB_COPILOT_TOKEN=ghu_...  # Token de Copilot
# Usa el mismo GITHUB_TOKEN para GitHub Models

# ── Ollama local ── gratuito (modelos locales)
OLLAMA_LOCAL_URL=http://localhost:11434
OLLAMA_LOCAL_MODEL=hermes3:8b
# ── Ollama Cloud (Pro) ── clave en panel (Proveedores) o acá
# OLLAMA_CLOUD_API_KEY=...
# OLLAMA_CLOUD_MODEL=gemma3:27b
# ── Imágenes con Ollama (primero en generate_image y fotos de producto) ──
# Modelos x/imagegen: x/z-image-turbo (rápido, Apache 2.0) o x/flux2-klein:4b
# (texto legible, Apache 2.0). Sin esto o sin servidor, cae a DALL-E→G4F→Pollinations.
# OLLAMA_IMAGE_MODEL=x/z-image-turbo
# ── Reparto por servicio (el motor elige el modelo por propósito) ──
# Proveedor principal: pantalla Configuración → Proveedor Principal (vale
# ollama_cloud). Por tarea (vacío = reparto medido por defecto):
# ventas+objeciones (rápido y certero) .... IA_VENDEDOR=gemma4:31b-cloud
# intención (lo más rápido que acertó) .... IA_INTENCION=gemma4:31b-cloud
# redacción (detalle) .................... IA_REDACCION=gpt-oss:120b-cloud,gemma4:31b-cloud
# visión (el único que lee fotos) ........ IA_VISION=gemma4:31b-cloud (+DeepSeek visión de respaldo)
# fondo/reportes ......................... IA_FONDO=gpt-oss:20b-cloud,gemma4:31b-cloud
# off en cualquiera saca a Ollama de esa tarea (ej: IA_VISION=off).
# ── Visión de Atlas y del vendedor (ver imágenes adjuntas con ver_imagen) ──
# Orden "proveedor|modelo" separados por coma. Si se deja vacío, entra igual el
# respaldo DeepSeek visión; gemma4 de Ollama va primero solo si OLLAMA_LOCAL_URL
# está seteado. IA_VISION=off saca a Ollama de la lista.
# VISION_MODELS=openrouter|qwen2.5-vl-72b-instruct,nvidia|meta/llama-3.2-90b-vision-instruct

# ── OpenCode ── tu servidor de OpenCode en EasyPanel
OPENCODE_API_KEY=...
OPENCODE_API_URL=https://api.opencode.ai/v1
OPENCODE_MODEL=deepseek-v4-flash-free

# ── Ollama Local quemado ── quemado Ollama (sistema SMK v2)
# Si tienes tu propio servidor de Ollama sin autenticación

# ── LMArenaBridge / G4F (puente local)
BRIDGE_LOCAL_URL=http://localhost:5000
BRIDGE_LOCAL_API_KEY=sin-clave
BRIDGE_LOCAL_MODEL=gpt-4o-mini

# ── AI Integrations (OpenCode wrapper)
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.opencode.ai/v1
AI_INTEGRATIONS_OPENAI_API_KEY=...
