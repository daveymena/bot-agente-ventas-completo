# ── VentasPro Stock ─────────────────────────────────────────────────────────
# Copiá este archivo a .env (o definí las variables en EasyPanel / Docker).

# Servidor
STOCK_PORT=3010
STOCK_APP_URL=https://stock.tudominio.com
STOCK_SESSION_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
STOCK_DATA_DIR=./data               # originales privados, derivados públicos y base SQLite
NODE_ENV=production

# Marca
STOCK_BRAND_NAME=VentasPro Stock
STOCK_BRAND_TAGLINE=Fotos, vectores, vídeos, audio y plantillas con licencia para tu negocio
STOCK_WATERMARK_TEXT=VentasPro Stock
STOCK_SUPPORT_EMAIL=soporte@ventasproia.com
STOCK_CURRENCY=COP
STOCK_LOCALE=es-CO

# Economía (en centavos de la moneda)
STOCK_CREDIT_VALUE_CENTS=1200000    # valor nominal de 1 crédito ($12.000 COP) para calcular regalías
STOCK_ROYALTY_IMAGE=0.33
STOCK_ROYALTY_VIDEO=0.35
STOCK_ROYALTY_AUDIO=0.35
STOCK_PAYOUT_MIN_CENTS=10000000     # mínimo para solicitar pago ($100.000 COP)
STOCK_SIGNUP_BONUS_CREDITS=3

# Administrador inicial (se crea al arrancar si no existe)
STOCK_ADMIN_EMAIL=admin@stock.local
STOCK_ADMIN_PASSWORD=
STOCK_ADMIN_NAME=Administración

# Límites de subida
STOCK_MAX_IMAGE_MB=60
STOCK_MAX_VIDEO_MB=1024
STOCK_MAX_AUDIO_MB=120
STOCK_MIN_IMAGE_PIXELS=4000000

# IA (opcional: autoetiquetado, búsqueda semántica y generación de imágenes). Compatible con OpenAI.
STOCK_AI_API_KEY=
STOCK_AI_BASE_URL=https://api.openai.com/v1
STOCK_AI_VISION_MODEL=gpt-4o-mini
STOCK_AI_TEXT_MODEL=gpt-4o-mini
STOCK_AI_IMAGE_MODEL=gpt-image-1

# Pagos (opcional). Sin Mercado Pago, los pedidos se pagan por transferencia y el admin los confirma.
STOCK_MP_ACCESS_TOKEN=
STOCK_TRANSFER_BANK=Bancolombia
STOCK_TRANSFER_NUMBER=000-000000-00
STOCK_TRANSFER_NAME=VentasPro SAS

# Herramientas
FFMPEG_PATH=ffmpeg                  # necesario para previsualizaciones de vídeo y MP3 del catálogo demo
STOCK_SEED_DEMO=true                # genera el catálogo de demostración la primera vez (ponelo en false en producción real)
