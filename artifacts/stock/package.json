{
  "name": "@workspace/stock",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "VentasPro Stock — marketplace de contenido de archivo (fotos, vectores, ilustraciones, vídeo, audio, plantillas) con licencias, colecciones, portal de colaboradores y generación con IA. Ingeniería inversa de Adobe Stock.",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"pnpm run dev:api\" \"pnpm run dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "pnpm run build:web && pnpm run build:api",
    "build:web": "vite build",
    "build:api": "node ./build.mjs",
    "start": "node --enable-source-maps dist/server/index.mjs",
    "seed": "tsx server/db/seed-cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@libsql/client": "^0.15.15",
    "@radix-ui/react-checkbox": "^1.1.5",
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-dropdown-menu": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.7",
    "@radix-ui/react-select": "^2.1.7",
    "@radix-ui/react-slider": "^1.2.4",
    "@radix-ui/react-switch": "^1.1.4",
    "@radix-ui/react-tabs": "^1.1.4",
    "@radix-ui/react-tooltip": "^1.2.0",
    "@tanstack/react-query": "catalog:",
    "bcryptjs": "^3.0.3",
    "clsx": "catalog:",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "dotenv": "^16.6.1",
    "express": "^5",
    "framer-motion": "catalog:",
    "lucide-react": "catalog:",
    "multer": "^2.0.2",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router-dom": "^7.15.1",
    "sharp": "^0.34.5",
    "tailwind-merge": "catalog:",
    "zod": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "concurrently": "^9.1.2",
    "esbuild": "^0.27.3",
    "jsdom": "^30.1.2",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "^3.2.4"
  }
}
