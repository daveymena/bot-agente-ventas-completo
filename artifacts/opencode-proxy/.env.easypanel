# =============================================================================
# OpenCode AI Proxy — Variables para EasyPanel
# =============================================================================
# Servicio: opencode-proxy | Puerto interno: 5000 | Health: /health
# =============================================================================

# ─── Servidor ───────────────────────────────────────────────────────────────
PORT=5000
LOG_LEVEL=INFO

# ─── OpenCode Zen (upstream) ────────────────────────────────────────────────
# ⚠️  REEMPLAZA con tu API Key de OpenCode Zen
OPENCODE_ZEN_API_KEY=sk-REEMPLAZA_CON_TU_CLAVE_ZEN
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
DEFAULT_MODEL=opencode/deepseek-v4-flash-free
MAX_TIMEOUT=180

# ─── Gunicorn ───────────────────────────────────────────────────────────────
GUNICORN_WORKERS=2
GUNICORN_WORKER_CLASS=gevent
GUNICORN_WORKER_CONNECTIONS=100
GUNICORN_TIMEOUT=240
INSTALL_DEPS_ON_START=false

# ─── Autenticación de clientes ──────────────────────────────────────────────
# Clave que usará el api-server para llamar a este proxy
API_KEY=sk-y8Fg5Ccoox-lVH0O8s1qzHaD6b6zrNNVExAxx_pcNZE

# ─── Rendimiento / cache ────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
CACHE_TIMEOUT=300
MODELS_CACHE_TIMEOUT=3600

# ─── CORS ───────────────────────────────────────────────────────────────────
CORS_ORIGINS=*
