# VentasPro Stock — banco de recursos (clon de Adobe Stock) · artifacts/stock
#
#   docker build -f Dockerfile.stock -t ventaspro-stock .
#   docker run -p 3010:3010 -v stock-data:/app/artifacts/stock/data \
#     -e STOCK_SESSION_SECRET=cambia-esto-por-32-caracteres \
#     -e STOCK_ADMIN_EMAIL=admin@tudominio.com -e STOCK_ADMIN_PASSWORD=una-clave-segura \
#     ventaspro-stock
#
# Un solo proceso sirve la API (/api, /media) y la interfaz compilada (dist/public).
FROM node:22-slim AS build

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
ENV PUPPETEER_SKIP_DOWNLOAD=true
RUN corepack enable
WORKDIR /app

RUN apt-get update && apt-get install -y python3 make g++ git && rm -rf /var/lib/apt/lists/*

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json .npmrc .pnpmrc* ./
COPY artifacts/api-server/package.json ./artifacts/api-server/
COPY artifacts/ventas-pro/package.json ./artifacts/ventas-pro/
COPY artifacts/stock/package.json ./artifacts/stock/
COPY lib/api-zod/package.json ./lib/api-zod/
COPY lib/api-spec/package.json ./lib/api-spec/
COPY lib/api-client-react/package.json ./lib/api-client-react/
COPY lib/db/package.json ./lib/db/
COPY lib/integrations-openai-ai-server/package.json ./lib/integrations-openai-ai-server/
COPY lib/integrations-openai-ai-react/package.json ./lib/integrations-openai-ai-react/
COPY packages/tienda/package.json ./packages/tienda/
COPY scripts/package.json ./scripts/

# Solo las dependencias de este paquete (y las del workspace que necesite).
RUN pnpm install --frozen-lockfile --filter @workspace/stock... 2>&1 | grep -v "ERR_PNPM_EXOTIC_SUBDEP\|ERR_PNPM_IGNORED_BUILDS" || true

COPY artifacts/stock ./artifacts/stock
RUN pnpm --filter @workspace/stock run build

# ── Imagen final ─────────────────────────────────────────────────────────────
FROM node:22-slim
WORKDIR /app
# ffmpeg: previsualizaciones de vídeo con marca de agua, pósters y waveforms de audio.
RUN apt-get update && apt-get install -y curl ffmpeg && rm -rf /var/lib/apt/lists/*

COPY --from=build /app /app

ENV NODE_ENV=production
ENV STOCK_PORT=3010
ENV HOST=0.0.0.0
# El catálogo de demostración se genera solo si la base está vacía; ponelo en false en producción real.
ENV STOCK_SEED_DEMO=true
EXPOSE 3010

HEALTHCHECK --interval=30s --timeout=10s --start-period=90s --retries=3 \
  CMD curl -f http://localhost:${STOCK_PORT}/api/meta || exit 1

# /app/artifacts/stock/data es el volumen persistente (SQLite + originales + derivados).
RUN mkdir -p /app/artifacts/stock/data
WORKDIR /app/artifacts/stock
CMD ["node", "--enable-source-maps", "dist/server/index.mjs"]
