# ========== DATABASE CONFIG (EasyPanel Production) ==========
# Set these in EasyPanel Environment Variables
DATABASE_URL=${DATABASE_URL}
DB_HOST=${DB_HOST:-79.143.187.160}
DB_PORT=${DB_PORT:-5432}
DB_NAME=${DB_NAME:-tecnovariedades-db}
DB_USER=${DB_USER:-postgres}
DB_PASS=${DB_PASS}

# ========== SERVER CONFIG ==========
PORT=${PORT:-3002}
NODE_ENV=production
API_VERSION=v1

# ========== HERMES AGENT ==========
HERMES_URL=${HERMES_URL:-http://localhost:5000}

# ========== AI PROVIDERS CONFIGURATION ==========
# GitHub Copilot (Primary)
GITHUB_COPILOT_TOKEN=${GITHUB_COPILOT_TOKEN}
GITHUB_TOKEN=${GITHUB_TOKEN}
GITHUB_MODEL=${GITHUB_MODEL:-gpt-4o}
GITHUB_MODEL_CLAUDE=${GITHUB_MODEL_CLAUDE:-claude-sonnet-4-20250514}

# AI Fallback Chain (Rotación automática)
AI_FALLBACK_ENABLED=${AI_FALLBACK_ENABLED:-true}
AI_FALLBACK_ORDER=${AI_FALLBACK_ORDER:-opencode,github_copilot_internal,ollama_local,nvidia,github,g4f}

# Bridge Local (Fallback 1)
BRIDGE_LOCAL_URL=${BRIDGE_LOCAL_URL:-http://localhost:8000/api/v1}
BRIDGE_LOCAL_API_KEY=${BRIDGE_LOCAL_API_KEY}
BRIDGE_LOCAL_MODEL=${BRIDGE_LOCAL_MODEL:-deepseek-v4-flash}

# NVIDIA (Fallback 2)
NVIDIA_API_KEY=${NVIDIA_API_KEY}
NVIDIA_MODEL=${NVIDIA_MODEL:-meta/llama-3.1-70b-instruct}
NVIDIA_MODEL_FAST=${NVIDIA_MODEL_FAST:-meta/llama-3.1-8b-instruct}
NVIDIA_TIMEOUT=${NVIDIA_TIMEOUT:-30}

# Ollama Local (Fallback 3)
OLLAMA_LOCAL_URL=${OLLAMA_LOCAL_URL}
OLLAMA_LOCAL_MODEL=${OLLAMA_LOCAL_MODEL:-qwen3-coder:480b-cloud}
OLLAMA_TIMEOUT=${OLLAMA_TIMEOUT:-60}

# GitHub G4F (Fallback 4 - Last resort)
G4F_ENABLED=${G4F_ENABLED:-true}
G4F_PROVIDER=${G4F_PROVIDER:-auto}
G4F_MODEL=${G4F_MODEL:-gpt-4-turbo}
G4F_TIMEOUT=${G4F_TIMEOUT:-30}

# ========== PAYMENTS (Colombia) ==========
TRANSFER_NUMBER=${TRANSFER_NUMBER}
TRANSFER_NAME=${TRANSFER_NAME}
MERCADO_PAGO_PUBLIC_KEY=${MERCADO_PAGO_PUBLIC_KEY}
MERCADO_PAGO_ACCESS_TOKEN=${MERCADO_PAGO_ACCESS_TOKEN}
PAYPAL_CLIENT_ID=${PAYPAL_CLIENT_ID}
PAYPAL_CLIENT_SECRET=${PAYPAL_CLIENT_SECRET}
PAYPAL_MODE=${PAYPAL_MODE:-live}

# ========== NOTIFICATIONS (Email with SMTP) ==========
SMTP_HOST=${SMTP_HOST:-smtp.gmail.com}
SMTP_PORT=${SMTP_PORT:-587}
SMTP_USER=${SMTP_USER}
SMTP_PASS=${SMTP_PASS}
EMAIL_FROM=${EMAIL_FROM:-deinermena25@gmail.com}
EMAIL_TO=${EMAIL_TO:-daveymena16@gmail.com}

# ========== PERFORMANCE & ANTI-BAN ==========
TYPING_DELAY_MIN=${TYPING_DELAY_MIN:-800}
TYPING_DELAY_MAX=${TYPING_DELAY_MAX:-2000}
READ_RECEIPT_DELAY=${READ_RECEIPT_DELAY:-500}
HUMAN_PAUSE_MIN=${HUMAN_PAUSE_MIN:-1000}
HUMAN_PAUSE_MAX=${HUMAN_PAUSE_MAX:-3000}
RATE_LIMIT_REQUESTS=${RATE_LIMIT_REQUESTS:-100}
RATE_LIMIT_WINDOW=${RATE_LIMIT_WINDOW:-60000}

# ========== GIT AUTO-UPDATE ==========
GIT_BRANCH=${GIT_BRANCH:-main}
GIT_REMOTE=${GIT_REMOTE:-origin}

# ========== OPencode AI Provider (EasyPanel Hosted) ==========
OPENCODE_API_URL=${OPENCODE_API_URL:-https://tecnovariedades-provedor-ia.er7iaf.easypanel.host/v1}
OPENCODE_MODEL=${OPENCODE_MODEL:-opencode/deepseek-v4-flash-free}
OPENCODE_API_KEY=${OPENCODE_API_KEY}