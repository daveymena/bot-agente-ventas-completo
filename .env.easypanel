# ═══════════════════════════════════════════════════════════════
# CONFIGURACIÓN EASYPANEL — VARIABLES DE ENTORNO
# ═══════════════════════════════════════════════════════════════
# Define estas variables en el panel de EasyPanel > Project > Environment
# NO subas este archivo con valores reales a git

# ========== SERVER ==========
APP_URL=https://tu-dominio.easypanel.host
NODE_ENV=production
PORT=3002
USE_SQLITE=false

# ========== DATABASE ==========
DB_PASSWORD=postgres
DATABASE_URL=postgres://postgres:${DB_PASSWORD}@postgres:5432/tecnovariedades-db?sslmode=disable

# ========== AI PROVIDERS ==========
OPENCODE_API_KEY=
OPENCODE_API_URL=https://api.freemodel.dev/v1
OPENCODE_MODEL=deepseek-v4-flash-free

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

GITHUB_TOKEN=
GITHUB_MODEL=gpt-4o-mini
GITHUB_MODEL_CLAUDE=claude-sonnet-4-20250514

AI_FALLBACK_ENABLED=true
AI_FALLBACK_ORDER=opencode,groq,github,g4f

G4F_ENABLED=true
G4F_PROVIDER=auto
G4F_MODEL=gpt-4-turbo
G4F_TIMEOUT=30

# ========== PAYMENTS ==========
TRANSFER_NUMBER=
TRANSFER_NAME=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_ACCESS_TOKEN=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=live

# ========== EMAIL (SMTP) ==========
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_TO=

# ========== FACEBOOK ==========
FB_APP_ID=
FB_APP_SECRET=
FB_PAGE_ID=
FB_ACCESS_TOKEN=
FB_MESSENGER_PAGE_TOKEN=
FB_WEBHOOK_VERIFY_TOKEN=salesbot_verify_2024
FB_MESSENGER_VERIFY_TOKEN=salesbot_messenger_2024

# ========== ADMIN ==========
ADMIN_PHONE=

# ========== PERFORMANCE ==========
TYPING_DELAY_MIN=800
TYPING_DELAY_MAX=2000
READ_RECEIPT_DELAY=500
HUMAN_PAUSE_MIN=1000
HUMAN_PAUSE_MAX=3000
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60000
