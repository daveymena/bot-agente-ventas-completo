# ---------------------------------------------------------------------------
# Landing Forge Premium – VentasProIA
# Copia este archivo como `.env.local` (desarrollo) o pásalo como variables de
# entorno al contenedor (producción). Todo tiene valor por defecto: el módulo
# arranca sin configurar nada.
# ---------------------------------------------------------------------------

# --- Tienda ----------------------------------------------------------------
# Slug de la tienda en ventasproia.com y base de la API pública.
STORE_SLUG=sofia-premium
STORE_BASE=https://ventasproia.com

# --- Meta (Pixel y Conversions API) ----------------------------------------
# El Pixel se toma del propio catálogo (store.pixelId) y se puede editar en el
# panel. Estas variables son el respaldo del servidor.
META_PIXEL_ID=
# El token de CAPI NUNCA se expone al navegador: solo lo usa /api/store/capi.
META_CAPI_TOKEN=
# Código de evento de prueba del Administrador de eventos (opcional).
META_TEST_EVENT_CODE=

# --- Pedidos ---------------------------------------------------------------
# Webhook por defecto al que /api/store/order reenvía cada pedido.
# Si está vacío, el pedido igual se confirma y se abre WhatsApp: la landing
# nunca se rompe por falta de webhook.
ORDER_WEBHOOK_URL=
# Si lo defines, se manda como cabecera X-Webhook-Secret al webhook.
ORDER_WEBHOOK_SECRET=

# --- Landings publicadas ---------------------------------------------------
# Carpeta donde se guardan las landings de /l/[slug]. Móntala como volumen
# para que sobrevivan a los redespliegues.
LANDINGS_DIR=.data/landings

# --- IA opcional (solo para pulir redacción) -------------------------------
# El generador de copy funciona SIN IA. Esto es un extra.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
