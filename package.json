{
    "name": "bot-agente-ventas-completo",
    "version": "0.0.0",
    "private": true,
    "workspaces": [
        "artifacts/api-server",
        "artifacts/ventas-pro",
        "packages"
    ],
    "scripts": {
        "build": "pnpm run typecheck && pnpm -r --filter \"./artifacts/**\" --filter \"./packages/**\" run build",
        "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/api-server\" run typecheck",
        "typecheck:libs": "tsc --build",
        "dev": "pnpm -r --filter \"./artifacts/api-server\" run dev",
        "test": "pnpm -r test"
    },
    "devDependencies": {
        "@tailwindcss/oxide-win32-x64-msvc": "4.2.4",
        "@types/node": "^20.12.7",
        "lightningcss-win32-x64-msvc": "1.32.0",
        "tsx": "^4.7.3",
        "typescript": "^5.4.5"
    },
    "dependencies": {
        "@rollup/rollup-win32-x64-msvc": "4.60.2",
        "lightningcss": "1.32.0",
        "sql.js": "1.11.0"
    },
    "pnpm": {}
}
